@page "/utilizadores"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "AdminCadeia,AdminIT")]
@rendermode InteractiveServer
@using BeloMercado.Application.Dtos.Utilizadores
@using BeloMercado.Application.Dtos.Lojas
@using BeloMercado.BackofficeWeb.Auth
@inject UtilizadoresApiClient UtilizadoresApi
@inject LojasApiClient LojasApi
@inject NavigationManager Nav

<PageTitle>Utilizadores — Belo Mercado</PageTitle>

<div class="page">
    <header class="page-header">
        <h1>Utilizadores</h1>
        <div class="actions">
            <a href="/" class="back-link">← Voltar</a>
            <a href="/utilizadores/novo" class="btn btn-primary">+ Novo utilizador</a>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }
    @if (!string.IsNullOrEmpty(info))
    {
        <div class="alert alert-info">@info</div>
    }

    @if (busy)
    {
        <p>A carregar...</p>
    }
    else if (users.Count == 0)
    {
        <p class="empty">Sem utilizadores.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Email</th>
                    <th>Perfil</th>
                    <th>Loja</th>
                    <th>Estado</th>
                    <th>Último login</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in users)
                {
                    <tr class="@(u.Ativo ? "" : "row-inactive")">
                        <td>@u.Nome</td>
                        <td>@u.Email</td>
                        <td>@u.Perfil</td>
                        <td>@LojaNome(u.LojaId)</td>
                        <td>
                            <span class="badge @(u.Ativo ? "badge-ok" : "badge-off")">
                                @(u.Ativo ? "Ativo" : "Inativo")
                            </span>
                            @if (u.PasswordTemporaria)
                            {
                                <span class="badge badge-warn">Pwd temporária</span>
                            }
                        </td>
                        <td>@(u.UltimoLogin?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        <td class="actions-cell">
                            <a href="@($"/utilizadores/{u.Id}")" class="btn btn-link">Editar</a>
                            @if (u.Ativo)
                            {
                                <button class="btn btn-link btn-danger" @onclick="() => DeactivateAsync(u)">
                                    Desativar
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<UtilizadorResponse> users = new();
    private IReadOnlyList<LojaResponse> lojas = Array.Empty<LojaResponse>();
    private bool busy = true;
    private string? error;
    private string? info;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        busy = true;
        error = null;
        try
        {
            var lojasTask = LojasApi.ListAsync();
            var usersTask = UtilizadoresApi.ListAsync();
            await Task.WhenAll(lojasTask, usersTask);
            lojas = lojasTask.Result;
            users = usersTask.Result.OrderBy(u => u.Nome).ToList();
        }
        catch (Exception ex)
        {
            error = $"Erro ao carregar: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeactivateAsync(UtilizadorResponse u)
    {
        info = null;
        error = null;
        var result = await UtilizadoresApi.DeactivateAsync(u.Id);
        if (result.Success)
        {
            info = $"Utilizador {u.Nome} desativado.";
            await ReloadAsync();
        }
        else
        {
            error = $"Falha ao desativar: {result.ErrorCode ?? result.StatusCode.ToString()}";
        }
    }

    private string LojaNome(Guid? id) =>
        id is null ? "—" : (lojas.FirstOrDefault(l => l.Id == id)?.Designacao ?? id.Value.ToString()[..8]);
}

<style>
    .page { max-width: 100%; margin: 24px 0; padding: 0 24px; }
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
    .actions { display: flex; gap: 16px; align-items: center; }
    .back-link { color: #1f4ea1; text-decoration: none; }
    .btn { padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer; font-size: 0.9rem; text-decoration: none; }
    .btn-primary { background: #1f4ea1; color: white; }
    .btn-link { background: none; color: #1f4ea1; padding: 4px 8px; }
    .btn-danger { color: #b02a37; }
    .alert-danger { padding: 8px; background: #f8d7da; color: #842029; border-radius: 4px; margin-bottom: 12px; }
    .alert-info { padding: 8px; background: #cfe2ff; color: #084298; border-radius: 4px; margin-bottom: 12px; }
    table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid #ddd; border-radius: 8px; overflow: hidden; }
    th, td { padding: 10px 12px; border-bottom: 1px solid #eee; text-align: left; }
    th { background: #f5f5f7; font-weight: 600; }
    .row-inactive { background: #fafafa; color: #888; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 0.75rem; margin-right: 4px; }
    .badge-ok { background: #d1e7dd; color: #0f5132; }
    .badge-off { background: #e9ecef; color: #495057; }
    .badge-warn { background: #fff3cd; color: #664d03; }
    .actions-cell { display: flex; gap: 4px; }
    .empty { color: #888; font-style: italic; }
</style>
