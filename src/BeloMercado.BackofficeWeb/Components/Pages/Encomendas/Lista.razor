@page "/encomendas"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "GerenteLoja,AdminCadeia")]
@rendermode InteractiveServer
@using BeloMercado.Application.Dtos.Encomendas
@using BeloMercado.BackofficeWeb.Auth
@using Microsoft.AspNetCore.Components.Authorization
@inject EncomendasApiClient EncomendasApi
@inject AuthenticationStateProvider AuthState

<PageTitle>Encomendas — Belo Mercado</PageTitle>

<div class="page">
    <header class="page-header">
        <h1>Encomendas</h1>
        <div class="actions">
            <a href="/" class="back-link">← Voltar</a>
            <a href="/fornecedores" class="btn btn-link">Fornecedores</a>
            @if (podeCriar)
            {
                <a href="/encomendas/nova" class="btn btn-primary">+ Nova encomenda</a>
            }
        </div>
    </header>

    <div class="filters">
        <select @bind="estadoFiltro" class="form-control">
            <option value="">Todos os estados</option>
            <option value="Rascunho">Rascunho</option>
            <option value="Submetida">Submetida</option>
            <option value="ParcialmenteRecebida">Parcialmente recebida</option>
            <option value="Recebida">Recebida</option>
            <option value="Cancelada">Cancelada</option>
        </select>
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (busy)
    {
        <p>A carregar...</p>
    }
    else if (Filtradas().Count == 0)
    {
        <p class="empty">Sem encomendas.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Criada em</th>
                    <th>Fornecedor</th>
                    <th>Estado</th>
                    <th class="num">Total</th>
                    <th class="num">Linhas</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Filtradas())
                {
                    <tr>
                        <td>@e.DataCriacao.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@e.FornecedorNome</td>
                        <td><span class="badge @EstadoBadge(e.Estado)">@e.Estado</span></td>
                        <td class="num">@e.Total.ToString("C", pt)</td>
                        <td class="num">@e.Linhas.Count</td>
                        <td><a href="@($"/encomendas/{e.Id}")" class="btn btn-link">Ver</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private static readonly System.Globalization.CultureInfo pt =
        System.Globalization.CultureInfo.GetCultureInfo("pt-PT");

    private List<EncomendaResponse> encomendas = new();
    private string estadoFiltro = "";
    private bool busy = true;
    private bool podeCriar;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        // Tanto Gerente como Admin podem criar encomendas.
        podeCriar = state.User.IsInRole("GerenteLoja") || state.User.IsInRole("AdminCadeia");

        try
        {
            encomendas = (await EncomendasApi.ListAsync())
                .OrderByDescending(e => e.DataCriacao).ToList();
        }
        catch (Exception ex)
        {
            error = $"Erro ao carregar: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }

    private List<EncomendaResponse> Filtradas() =>
        string.IsNullOrEmpty(estadoFiltro)
            ? encomendas
            : encomendas.Where(e => e.Estado == estadoFiltro).ToList();

    private static string EstadoBadge(string estado) => estado switch
    {
        "Rascunho" => "badge-gray",
        "Submetida" => "badge-info",
        "ParcialmenteRecebida" => "badge-warn",
        "Recebida" => "badge-ok",
        "Cancelada" => "badge-off",
        _ => "badge-gray"
    };
}

<style>
    .page { max-width: 100%; margin: 24px 0; padding: 0 24px; }
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
    .actions { display: flex; gap: 12px; align-items: center; }
    .back-link { color: #1f4ea1; text-decoration: none; }
    .filters { margin-bottom: 16px; }
    .form-control { padding: 6px 10px; border: 1px solid #ccc; border-radius: 4px; font-size: 0.9rem; }
    .btn { padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer; font-size: 0.9rem; text-decoration: none; }
    .btn-primary { background: #1f4ea1; color: white; }
    .btn-link { background: none; color: #1f4ea1; padding: 4px 8px; }
    .alert-danger { padding: 8px; background: #f8d7da; color: #842029; border-radius: 4px; margin-bottom: 12px; }
    table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid #ddd; border-radius: 8px; overflow: hidden; }
    th, td { padding: 10px 12px; border-bottom: 1px solid #eee; text-align: left; }
    th { background: #f5f5f7; font-weight: 600; }
    th.num, td.num { text-align: right; }
    .badge { display: inline-block; padding: 2px 10px; border-radius: 12px; font-size: 0.78rem; }
    .badge-ok { background: #d1e7dd; color: #0f5132; }
    .badge-warn { background: #fff3cd; color: #664d03; }
    .badge-info { background: #cfe2ff; color: #084298; }
    .badge-gray { background: #e2e3e5; color: #41464b; }
    .badge-off { background: #f8d7da; color: #842029; }
    .empty { color: #888; font-style: italic; }
</style>
