@page "/lojas"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "AdminCadeia")]
@rendermode InteractiveServer
@using BeloMercado.Application.Dtos.Lojas
@using BeloMercado.BackofficeWeb.Auth
@inject LojasApiClient LojasApi

<PageTitle>Lojas — Belo Mercado</PageTitle>

<div class="page">
    <header class="page-header">
        <h1>Lojas</h1>
        <div class="actions">
            <a href="/" class="back-link">← Voltar</a>
            <a href="/lojas/nova" class="btn btn-primary">+ Nova loja</a>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (busy)
    {
        <p>A carregar...</p>
    }
    else if (lojas.Count == 0)
    {
        <p class="empty">Sem lojas registadas.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Designação</th>
                    <th>Morada</th>
                    <th>Contacto</th>
                    <th>Email</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in lojas.OrderBy(l => l.Designacao))
                {
                    <tr class="@(l.Ativo ? "" : "row-inactive")">
                        <td><strong>@l.Designacao</strong></td>
                        <td>
                            @l.Morada
                            <br /><small>@l.CodigoPostal</small>
                        </td>
                        <td>@l.Contacto</td>
                        <td>@l.Email</td>
                        <td>
                            <span class="badge @(l.Ativo ? "badge-ok" : "badge-off")">
                                @(l.Ativo ? "Ativa" : "Inativa")
                            </span>
                        </td>
                        <td>
                            <a href="@($"/lojas/{l.Id}")" class="btn btn-link">Editar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<LojaResponse> lojas = new();
    private bool busy = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try { lojas = (await LojasApi.ListAsync()).ToList(); }
        catch (Exception ex) { error = $"Erro ao carregar: {ex.Message}"; }
        finally { busy = false; }
    }
}

<style>
    .page { max-width: 100%; margin: 24px 0; padding: 0 24px; }
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
    .actions { display: flex; gap: 16px; align-items: center; }
    .back-link { color: #1f4ea1; text-decoration: none; }
    .btn { padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer; font-size: 0.9rem; text-decoration: none; }
    .btn-primary { background: #1f4ea1; color: white; }
    .btn-link { background: none; color: #1f4ea1; padding: 4px 8px; }
    .alert-danger { padding: 8px; background: #f8d7da; color: #842029; border-radius: 4px; margin-bottom: 12px; }
    table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid #ddd; border-radius: 8px; overflow: hidden; }
    th, td { padding: 10px 12px; border-bottom: 1px solid #eee; text-align: left; vertical-align: top; }
    th { background: #f5f5f7; font-weight: 600; }
    th.num, td.num { text-align: right; }
    small { color: #888; }
    .row-inactive { background: #fafafa; color: #888; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 0.75rem; }
    .badge-ok { background: #d1e7dd; color: #0f5132; }
    .badge-off { background: #e9ecef; color: #495057; }
    .empty { color: #888; font-style: italic; }
</style>
