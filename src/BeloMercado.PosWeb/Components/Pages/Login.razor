@page "/login"
@using BeloMercado.PosWeb.Auth
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthApiClient AuthApi
@inject ApiAuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>Login — Belo Mercado POS</PageTitle>

<div class="login-card">
    <h2>Belo Mercado POS</h2>
    <EditForm Model="model" OnValidSubmit="OnSubmit" FormName="login">
        <DataAnnotationsValidator />

        <div class="form-group">
            <label>Email</label>
            <InputText @bind-Value="model.Email" class="form-control" autofocus />
            <ValidationMessage For="@(() => model.Email)" />
        </div>

        <div class="form-group">
            <label>Password</label>
            <InputText type="password" @bind-Value="model.Password" class="form-control" />
            <ValidationMessage For="@(() => model.Password)" />
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger">@error</div>
        }

        <button type="submit" class="btn btn-primary w-100" disabled="@busy">
            @(busy ? "A entrar..." : "Entrar")
        </button>
    </EditForm>
</div>

@code {
    [SupplyParameterFromForm]
    private LoginModel model { get; set; } = new();

    private string? error;
    private bool busy;

    private async Task OnSubmit()
    {
        busy = true;
        error = null;
        try
        {
            var resp = await AuthApi.LoginAsync(model.Email, model.Password);
            if (resp is null)
            {
                error = "Email ou password inválidos.";
                return;
            }
            await AuthState.NotifyLoginAsync(resp.AccessToken, resp.RefreshToken);
            Nav.NavigateTo("/", forceLoad: false);
        }
        finally
        {
            busy = false;
        }
    }

    public class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string Password { get; set; } = string.Empty;
    }
}

<style>
    .login-card { max-width: 380px; margin: 80px auto; padding: 24px; border: 1px solid #ddd; border-radius: 8px; }
    .form-group { margin-bottom: 12px; }
    .form-group label { display: block; font-weight: 500; margin-bottom: 4px; }
    .form-control { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; }
    .btn { padding: 10px; border-radius: 4px; border: none; cursor: pointer; }
    .btn-primary { background: #1f4ea1; color: white; }
    .btn:disabled { opacity: 0.5; }
    .alert-danger { padding: 8px; background: #f8d7da; color: #842029; border-radius: 4px; margin-bottom: 8px; }
    .w-100 { width: 100%; }
</style>
