@page "/caixa"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using BeloMercado.Application.Dtos.Caixa
@using BeloMercado.PosWeb.Auth
@inject CaixasApiClient CaixasApi
@inject NavigationManager Nav

<PageTitle>Abrir Caixa — Belo Mercado POS</PageTitle>

<div class="caixa-card">
    <h2>Abrir Caixa</h2>

    @if (loadingEstado)
    {
        <p class="text-muted">A verificar estado da caixa...</p>
    }
    else if (caixaHoje is not null && caixaHoje.Estado == "Aberta")
    {
        <div class="alert alert-info">
            Já existe uma <strong>caixa aberta</strong> para esta loja hoje
            (desde @caixaHoje.DataHoraAbertura.ToLocalTime().ToString("HH:mm")).
        </div>
        <a href="@($"/caixa/{caixaHoje.Id}")" class="btn btn-primary w-100">Ir para a caixa atual</a>
    }
    else if (caixaHoje is not null && caixaHoje.Estado == "Fechada")
    {
        <div class="alert alert-warning">
            <strong>Caixa de hoje já encerrada</strong> às
            @(caixaHoje.DataHoraFecho?.ToLocalTime().ToString("HH:mm")).
            Só pode haver <strong>uma caixa por loja por dia</strong> — a próxima abertura é amanhã.
        </div>
        <a href="@($"/caixa/{caixaHoje.Id}")" class="btn btn-secondary w-100">Ver resumo da caixa de hoje</a>
    }
    else
    {
        <p class="lead">Antes de começar a registar vendas, é preciso abrir a caixa do dia.</p>

        <EditForm Model="model" OnValidSubmit="OnSubmit" FormName="abrirCaixa">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label>Fundo inicial (€)</label>
                <InputNumber @bind-Value="model.FundoInicial" class="form-control" step="0.01" min="0" />
                <ValidationMessage For="@(() => model.FundoInicial)" />
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger">@error</div>
            }

            <button type="submit" class="btn btn-primary w-100" disabled="@busy">
                @(busy ? "A abrir..." : "Abrir Caixa")
            </button>
        </EditForm>
    }
</div>

@code {
    [SupplyParameterFromForm] private FormModel model { get; set; } = new();
    private bool busy;
    private bool loadingEstado = true;
    private CaixaResponse? caixaHoje;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try { caixaHoje = await CaixasApi.GetHojeAsync(); }
        catch { caixaHoje = null; }
        finally { loadingEstado = false; }
    }

    private async Task OnSubmit()
    {
        busy = true; error = null;
        try
        {
            var result = await CaixasApi.AbrirAsync(model.FundoInicial);
            if (result.Success && result.Caixa is not null)
            {
                Nav.NavigateTo($"/caixa/{result.Caixa.Id}");
                return;
            }
            error = result.ErrorCode switch
            {
                "CAIXA_JA_ABERTA" => "Já existe uma caixa para esta loja hoje (só pode haver uma por dia).",
                "CAIXA_FUNDO_INVALIDO" => "Fundo inicial inválido.",
                "CAIXA_LOJA_OBRIGATORIA" => "O operador não tem loja associada.",
                _ => $"Erro ao abrir caixa (HTTP {result.StatusCode})."
            };
        }
        finally { busy = false; }
    }

    public class FormModel
    {
        [System.ComponentModel.DataAnnotations.Range(0, 99999.99, ErrorMessage = "Valor inválido.")]
        public decimal FundoInicial { get; set; } = 0;
    }
}

<style>
    .caixa-card { max-width: 640px; margin: 40px auto; padding: 24px;
                  border: 1px solid #ddd; border-radius: 8px; background: #fff; }
    .caixa-card h2 { margin: 0 0 8px; }
    .lead { color: #555; margin: 0 0 16px; }
    .info { background: #eef3fb; border-left: 4px solid #1f4ea1;
            padding: 12px 14px; border-radius: 4px; margin-bottom: 16px;
            display: grid; gap: 6px; }
    .info strong { color: #1f4ea1; }
    .info .hint { color: #555; font-size: 0.9rem; font-style: italic; }
    .form-group { margin-bottom: 12px; }
    .form-group label { display: block; font-weight: 500; margin-bottom: 4px; }
    .form-control { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; }
    .text-muted { color: #6c757d; }
    .btn { padding: 10px; border-radius: 4px; border: none; cursor: pointer; }
    .btn-primary { background: #1f4ea1; color: white; }
    .btn:disabled { opacity: 0.5; }
    .alert-danger { padding: 8px; background: #f8d7da; color: #842029; border-radius: 4px; margin-bottom: 8px; }
    .alert-info { padding: 12px; background: #cfe2ff; color: #084298; border-radius: 4px; margin-bottom: 12px; }
    .alert-warning { padding: 12px; background: #fff3cd; color: #664d03; border-radius: 4px; margin-bottom: 12px; }
    .btn-secondary { background: #6c757d; color: white; padding: 10px; border-radius: 4px; border: none; cursor: pointer; text-decoration: none; display: inline-block; text-align: center; }
    .w-100 { width: 100%; }
</style>
